elif menu == "📈 Evaluasi & Komparasi Model":
    st.markdown("""
        <div class="hero">
            <div class="eyebrow">MODEL EVALUATION & SELECTION</div>
            <h1>Komparasi Tiga Algoritma Machine Learning</h1>
            <p>Sesuai rubrik PJBL, tiga algoritma dibandingkan: <strong>Random Forest, Logistic Regression, dan Decision Tree</strong>. Pemilihan model dikunci berdasarkan performa 5-Fold Stratified Cross-Validation pada data latih.</p>
        </div>
    """, unsafe_allow_html=True)

    modeling_dir = ROOT_DIR / "Source_Code/reports/modeling"
    analysis_dir = ROOT_DIR / "Source_Code/reports/analysis"
    comp_file = modeling_dir / "model_comparison.csv"

    if comp_file.exists():
        df_comp = pd.read_csv(comp_file)
        st.markdown("### Tabel Evaluasi Komparatif Model")

        table_display = df_comp[[
            "model", "cv_f1_mean", "cv_f1_std", "train_f1_macro",
            "test_accuracy", "test_precision_macro", "test_recall_macro", "test_f1_macro", "selected_by_cv"
        ]].copy()
        table_display.columns = [
            "Nama Algoritma", "CV Macro-F1 (Mean)", "CV Macro-F1 (Std)", "Train Macro-F1",
            "Test Accuracy", "Test Precision Macro", "Test Recall Macro", "Test Macro-F1", "Model Terpilih (CV)"
        ]
        st.dataframe(
            table_display.style.highlight_max(
                subset=["CV Macro-F1 (Mean)", "Test Macro-F1"],
                color="#c6f6d5"
            ),
            use_container_width=True
        )

    st.markdown("---")
    c_ev1, c_ev2 = st.columns(2)

    with c_ev1:
        st.markdown("#### Matriks Konfusi (Confusion Matrix Holdout)")
        img_cm = modeling_dir / "01_confusion_matrices.png"
        if img_cm.exists():
            st.image(str(img_cm), caption="Confusion Matrix Ketiga Model pada Data Uji (N = 7.252)", use_container_width=True)

    with c_ev2:
        st.markdown("#### Perbandingan Kinerja Metrik")
        img_comp = modeling_dir / "02_model_comparison.png"
        if img_comp.exists():
            st.image(str(img_comp), caption="Perbandingan Metrik Kinerja Tiga Model", use_container_width=True)

    st.markdown("---")
    st.markdown("### Interpretasi & Faktor-Faktor Paling Berpengaruh")

    c_inf1, c_inf2 = st.columns(2)
    with c_inf1:
        img_perm = analysis_dir / "02_permutation_importance.png"
        if img_perm.exists():
            st.image(str(img_perm), caption="Permutation Feature Importance (Random Forest)", use_container_width=True)
        st.markdown("""
            **Analisis Fitur Kunci:**
            1. **Trouble Sleeping History (Riwayat Gangguan Tidur)**: Penurunan terbesar performa F1 jika diacak, menegaskan korelasi kuat antara gangguan tidur kronis dan depresi.
            2. **Cant Work (Ketidakmampuan Bekerja)**: Indikator disabilitas fungsional akibat gangguan fisik/mental.
            3. **Memory Problems (Gangguan Konsentrasi/Memori)**: Gejala kognitif khas dari episode depresi mayor.
            4. **Sedentary Time & Sleep Hours**: Pola perilaku harian yang sangat berkorelasi dengan suasana hati dan kesehatan mental.
        """)

    with c_inf2:
        img_coef = analysis_dir / "03_logistic_coefficients.png"
        if img_coef.exists():
            st.image(str(img_coef), caption="Koefisien Bobot Logit (Logistic Regression)", use_container_width=True)
        st.markdown("""
            **Interpretasi Koefisien Logistik:**
            - Koefisien positif tertinggi: Riwayat insomnia (*Trouble Sleeping: Yes*), ketidakmampuan bekerja (*Cant Work: Yes*), dan gangguan ingatan (*Memory Problems: Yes*).
            - Koefisien protektif (negatif): Pendapatan rumah tangga memadai (*$75K+*), pendidikan tinggi (*College Graduate*), dan olahraga teratur.
        """)


