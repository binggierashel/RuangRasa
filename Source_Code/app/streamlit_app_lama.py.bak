"""Aplikasi Web Streamlit MindScope - Skrining Risiko Gangguan Depresi.
Mengimplementasikan prediksi individu, prediksi batch CSV, eksplorasi data, evaluasi model komparatif, dan informasi proyek.
"""
from pathlib import Path
import json
import joblib
import pandas as pd
import numpy as np
import streamlit as st

# Setup Path Proyek
APP_DIR = Path(__file__).resolve().parent
SRC_DIR = APP_DIR.parent
ROOT_DIR = SRC_DIR.parent

import sys
if str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))

from depresi_project import (
    TARGET, LABELS, DISPLAY, FEATURES, CATEGORICAL, NUMERIC, RANGES,
    prepare_features, validate_input
)

# Konfigurasi Halaman Streamlit
st.set_page_config(
    page_title="MindScope - Skrining Depresi ML",
    page_icon="🧠",
    layout="wide",
    initial_sidebar_state="expanded"
)

# Muat Custom CSS
css_file = APP_DIR / "styles.css"
if css_file.exists():
    st.markdown(f"<style>{css_file.read_text(encoding='utf-8')}</style>", unsafe_allow_html=True)


@st.cache_resource
def load_artifacts():
    """Memuat model ter-fit, skema input, dan metadata pelatihan."""
    schema_path = ROOT_DIR / "Model/input_schema.json"
    metadata_path = ROOT_DIR / "Model/model_metadata.json"
    schema = json.loads(schema_path.read_text(encoding="utf-8"))
    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))

    models = {
        "Random Forest (Terpilih / Terbaik)": joblib.load(ROOT_DIR / "Model/random_forest_pipeline.joblib"),
        "Logistic Regression": joblib.load(ROOT_DIR / "Model/logistic_regression_pipeline.joblib"),
        "Decision Tree": joblib.load(ROOT_DIR / "Model/decision_tree_pipeline.joblib"),
    }
    return schema, metadata, models


try:
    SCHEMA, METADATA, MODELS = load_artifacts()
except Exception as e:
    st.error(f"Gagal memuat artefak model: {e}")
    st.stop()


# Navigasi Bilah Sisi (Sidebar)
with st.sidebar:
    st.markdown("""
        <div class="brand">
            <div class="brand-icon">🧠</div>
            <div>
                <div class="brand-name">MindScope</div>
                <div class="brand-caption">Depression Risk Screening AI</div>
            </div>
        </div>
    """, unsafe_allow_html=True)

    menu = st.radio(
        "Navigasi Modul",
        [
            "🩺 Prediksi Individu",
            "📂 Prediksi Batch (CSV)",
            "📊 Eksplorasi Data (EDA)",
            "📈 Evaluasi & Komparasi Model",
            "ℹ️ Informasi Proyek & Tim"
        ],
        index=0,
        label_visibility="collapsed"
    )

    st.markdown("<hr>", unsafe_allow_html=True)
    st.markdown("<div class=\"side-label\">PILIHAN MODEL AKTIF</div>", unsafe_allow_html=True)
    selected_model_name = st.selectbox(
        "Algoritma Inferensi",
        list(MODELS.keys()),
        index=0,
        help="Model default adalah Random Forest (terpilih strictly dari 5-Fold Stratified Training CV)."
    )
    current_model = MODELS[selected_model_name]

    st.markdown("<hr>", unsafe_allow_html=True)
    st.markdown("""
        <div class="side-note">
            <strong>Keterangan Klinis:</strong><br>
            Aplikasi ini ditujukan untuk keperluan skrining awal dan edukasi berdasarkan data CDC NHANES (ambang skor PHQ-9 ≥ 10). Bukan pengganti diagnosis medis resmi psikiater.
        </div>
    """, unsafe_allow_html=True)


# ==============================================================================
# 1. HALAMAN: PREDIKSI INDIVIDU
# ==============================================================================
if menu == "🩺 Prediksi Individu":
    st.markdown("""
        <div class="hero">
            <div class="eyebrow">SKRINING INDIVIDU</div>
            <h1>Prediksi Risiko Gangguan Depresi Mayor</h1>
            <p>Masukkan indikator demografi, riwayat tidur, gaya hidup, kapasitas fungsional, dan pengukuran vital untuk mengestimasi risiko depresi klinis.</p>
            <div class="hero-tags">
                <span>Dataset: CDC NHANES</span>
                <span>Standar: PHQ-9 Screening ≥ 10</span>
                <span>Model Aktif: """ + selected_model_name.split()[0] + """</span>
            </div>
        </div>
    """, unsafe_allow_html=True)

    # Preset profiles demo
    col_pre1, col_pre2, col_pre3, _ = st.columns([1.3, 1.3, 1, 2])
    with col_pre1:
        load_low_risk = st.button("🟢 Muat Contoh Risiko Rendah", use_container_width=True)
    with col_pre2:
        load_high_risk = st.button("🔴 Muat Contoh Risiko Tinggi", use_container_width=True)
    with col_pre3:
        reset_defaults = st.button("🔄 Reset Input", use_container_width=True)

    # Default values dictionary
    defaults = {
        "Gender": "Female",
        "Age": 38,
        "Education Level": "College Graduate or Above",
        "Marital Status": "Married",
        "Household Income": "$75K+",
        "Sleep Hours": 7.5,
        "Trouble Sleeping History": "No",
        "Sedentary Time": 300.0,
        "Vigorous Recreation": "Yes",
        "Moderate Recreation": "Yes",
        "Current Smoker": "Never",
        "Memory Problems": "No",
        "Cant Work": "No",
        "Limited Work": "No",
        "BMI": 23.5,
        "Systolic": 118.0,
        "Diastolic": 76.0,
        "Pulse": 70.0
    }

    if load_low_risk:
        st.session_state["inputs"] = {
            "Gender": "Male",
            "Age": 32,
            "Education Level": "College Graduate or Above",
            "Marital Status": "Married",
            "Household Income": "$75K+",
            "Sleep Hours": 7.5,
            "Trouble Sleeping History": "No",
            "Sedentary Time": 240.0,
            "Vigorous Recreation": "Yes",
            "Moderate Recreation": "Yes",
            "Current Smoker": "Never",
            "Memory Problems": "No",
            "Cant Work": "No",
            "Limited Work": "No",
            "BMI": 22.8,
            "Systolic": 115.0,
            "Diastolic": 75.0,
            "Pulse": 68.0
        }
    elif load_high_risk:
        st.session_state["inputs"] = {
            "Gender": "Female",
            "Age": 46,
            "Education Level": "High School",
            "Marital Status": "Divorced",
            "Household Income": "Below $15K",
            "Sleep Hours": 4.5,
            "Trouble Sleeping History": "Yes",
            "Sedentary Time": 660.0,
            "Vigorous Recreation": "No",
            "Moderate Recreation": "No",
            "Current Smoker": "Every Day",
            "Memory Problems": "Yes",
            "Cant Work": "Yes",
            "Limited Work": "Yes",
            "BMI": 33.2,
            "Systolic": 138.0,
            "Diastolic": 88.0,
            "Pulse": 88.0
        }
    elif reset_defaults or "inputs" not in st.session_state:
        st.session_state["inputs"] = defaults

    val = st.session_state["inputs"]

    with st.form("form_skrining_depresi"):
        st.markdown("""
            <div class="form-section">
                <div class="form-icon">👤</div>
                <div>
                    <div class="form-title">1. Karakteristik Demografi & Sosioekonomi</div>
                    <div class="form-subtitle">Informasi profil dasar dan latar belakang sosial ekonomi</div>
                </div>
            </div>
        """, unsafe_allow_html=True)

        r1_c1, r1_c2, r1_c3 = st.columns(3)
        with r1_c1:
            inp_gender = st.selectbox(
                "Jenis Kelamin (Gender)",
                SCHEMA["categories"]["Gender"],
                index=SCHEMA["categories"]["Gender"].index(val["Gender"])
            )
        with r1_c2:
            inp_age = st.number_input(
                "Usia (Tahun)",
                min_value=18, max_value=100,
                value=int(val["Age"]), step=1
            )
        with r1_c3:
            inp_marital = st.selectbox(
                "Status Pernikahan (Marital Status)",
                SCHEMA["categories"]["Marital Status"],
                index=SCHEMA["categories"]["Marital Status"].index(val["Marital Status"])
            )

        r2_c1, r2_c2 = st.columns(2)
        with r2_c1:
            inp_edu = st.selectbox(
                "Tingkat Pendidikan (Education Level)",
                SCHEMA["categories"]["Education Level"],
                index=SCHEMA["categories"]["Education Level"].index(val["Education Level"])
            )
        with r2_c2:
            inp_income = st.selectbox(
                "Pendapatan Rumah Tangga per Tahun (Annual Household Income)",
                SCHEMA["categories"]["Household Income"],
                index=SCHEMA["categories"]["Household Income"].index(val["Household Income"]),
                help="Total pendapatan kotor rumah tangga dalam 1 tahun (USD/tahun) sesuai standar survei CDC NHANES."
            )

        st.markdown("<hr style='margin: 18px 0;'>", unsafe_allow_html=True)
        st.markdown("""
            <div class="form-section">
                <div class="form-icon">🛌</div>
                <div>
                    <div class="form-title">2. Pola Tidur & Riwayat Gangguan Tidur</div>
                    <div class="form-subtitle">Durasi istirahat dan keluhan insomnia/gangguan tidur konsisten</div>
                </div>
            </div>
        """, unsafe_allow_html=True)

        c4, c5 = st.columns(2)
        with c4:
            inp_sleep = st.number_input(
                "Durasi Tidur Harian (Jam)",
                min_value=1.0, max_value=18.0,
                value=float(val["Sleep Hours"]), step=0.5,
                help="Rata-rata jumlah jam tidur per malam."
            )
        with c5:
            inp_trouble_sleep = st.selectbox(
                "Riwayat Gangguan Tidur / Insomnia",
                SCHEMA["categories"]["Trouble Sleeping History"],
                index=SCHEMA["categories"]["Trouble Sleeping History"].index(val["Trouble Sleeping History"]),
                help="Pernahkah memberi tahu dokter atau mengeluhkan gangguan tidur kronis? (Trouble Sleeping History)"
            )

        st.markdown("<hr style='margin: 18px 0;'>", unsafe_allow_html=True)
        st.markdown("""
            <div class="form-section">
                <div class="form-icon">🏃</div>
                <div>
                    <div class="form-title">3. Gaya Hidup, Aktivitas Fisik & Merokok</div>
                    <div class="form-subtitle">Tingkat sedentari harian dan intensitas olahraga rutin</div>
                </div>
            </div>
        """, unsafe_allow_html=True)

        c6, c7, c8, c9 = st.columns(4)
        with c6:
            inp_sedentary = st.number_input(
                "Waktu Sedentari (Menit)",
                min_value=0.0, max_value=1440.0,
                value=float(val["Sedentary Time"]), step=30.0,
                help="Waktu yang dihabiskan untuk duduk/berbaring di luar waktu tidur per hari (misal 300 menit = 5 jam)."
            )
        with c7:
            inp_vigorous = st.selectbox(
                "Olahraga Berat (Vigorous)",
                SCHEMA["categories"]["Vigorous Recreation"],
                index=SCHEMA["categories"]["Vigorous Recreation"].index(val["Vigorous Recreation"]),
                help="Aktivitas fisik intensitas tinggi rutin minimal 10 menit (Vigorous Recreation)."
            )
        with c8:
            inp_moderate = st.selectbox(
                "Olahraga Sedang (Moderate)",
                SCHEMA["categories"]["Moderate Recreation"],
                index=SCHEMA["categories"]["Moderate Recreation"].index(val["Moderate Recreation"]),
                help="Aktivitas fisik intensitas sedang rutin minimal 10 menit (Moderate Recreation)."
            )
        with c9:
            inp_smoker = st.selectbox(
                "Status Merokok (Smoker)",
                SCHEMA["categories"]["Current Smoker"],
                index=SCHEMA["categories"]["Current Smoker"].index(val["Current Smoker"]),
                help="Kebiasaan merokok tembakau saat periode pemeriksaan (Current Smoker)."
            )

        st.markdown("<hr style='margin: 18px 0;'>", unsafe_allow_html=True)
        st.markdown("""
            <div class="form-section">
                <div class="form-icon">🧠</div>
                <div>
                    <div class="form-title">4. Kapasitas Kognitif & Kemampuan Bekerja</div>
                    <div class="form-subtitle">Dampak fisik atau mental terhadap konsentrasi dan produktivitas kerja</div>
                </div>
            </div>
        """, unsafe_allow_html=True)

        c10, c11, c12 = st.columns(3)
        with c10:
            inp_memory = st.selectbox(
                "Gangguan Memori / Fokus",
                SCHEMA["categories"]["Memory Problems"],
                index=SCHEMA["categories"]["Memory Problems"].index(val["Memory Problems"]),
                help="Keluhan sering lupa, daya ingat menurun, atau sulit berkonsentrasi (Memory Problems)."
            )
        with c11:
            inp_cant_work = st.selectbox(
                "Ketidakmampuan Bekerja",
                SCHEMA["categories"]["Cant Work"],
                index=SCHEMA["categories"]["Cant Work"].index(val["Cant Work"]),
                help="Tidak mampu bekerja akibat masalah kesehatan fisik atau mental/emosional (Cant Work)."
            )
        with c12:
            inp_limited_work = st.selectbox(
                "Keterbatasan Beban Kerja",
                SCHEMA["categories"]["Limited Work"],
                index=SCHEMA["categories"]["Limited Work"].index(val["Limited Work"]),
                help="Keterbatasan jenis atau beban pekerjaan akibat kondisi kesehatan (Limited Work)."
            )

        st.markdown("<hr style='margin: 18px 0;'>", unsafe_allow_html=True)
        st.markdown("""
            <div class="form-section">
                <div class="form-icon">🩺</div>
                <div>
                    <div class="form-title">5. Pengukuran Fisiologis & Tanda Vital</div>
                    <div class="form-subtitle">Indeks Massa Tubuh (BMI), Tekanan Darah, dan Denyut Nadi</div>
                </div>
            </div>
        """, unsafe_allow_html=True)

        c13, c14, c15, c16 = st.columns(4)
        with c13:
            inp_bmi = st.number_input(
                "Indeks Massa Tubuh (BMI)",
                min_value=12.0, max_value=70.0,
                value=float(val["BMI"]), step=0.1,
                help="Berat badan (kg) dibagi kuadrat tinggi badan (m)."
            )
        with c14:
            inp_systolic = st.number_input(
                "Tekanan Sistolik (mmHg)",
                min_value=70.0, max_value=240.0,
                value=float(val["Systolic"]), step=1.0,
                help="Tekanan darah sistolik saat istirahat."
            )
        with c15:
            inp_diastolic = st.number_input(
                "Tekanan Diastolik (mmHg)",
                min_value=40.0, max_value=150.0,
                value=float(val["Diastolic"]), step=1.0,
                help="Tekanan darah diastolik saat istirahat."
            )
        with c16:
            inp_pulse = st.number_input(
                "Denyut Nadi (BPM)",
                min_value=40.0, max_value=200.0,
                value=float(val["Pulse"]), step=1.0,
                help="Frekuensi denyut nadi istirahat (denyut per menit)."
            )

        submitted = st.form_submit_button("🔍 Lakukan Skrining Prediksi", use_container_width=True, type="primary")

    if submitted:
        input_dict = {
            "Gender": inp_gender,
            "Education Level": inp_edu,
            "Marital Status": inp_marital,
            "Household Income": inp_income,
            "Trouble Sleeping History": inp_trouble_sleep,
            "Vigorous Recreation": inp_vigorous,
            "Moderate Recreation": inp_moderate,
            "Current Smoker": inp_smoker,
            "Memory Problems": inp_memory,
            "Cant Work": inp_cant_work,
            "Limited Work": inp_limited_work,
            "Age": inp_age,
            "Sleep Hours": inp_sleep,
            "Sedentary Time": inp_sedentary,
            "BMI": inp_bmi,
            "Systolic": inp_systolic,
            "Diastolic": inp_diastolic,
            "Pulse": inp_pulse
        }
        df_input = pd.DataFrame([input_dict])

        try:
            valid_df = validate_input(df_input, SCHEMA)
            prediction = current_model.predict(valid_df)[0]
            probs = current_model.predict_proba(valid_df)[0]
            prob_dict = dict(zip(current_model.classes_, probs))

            is_depressed = (prediction == "Depressed")
            res_card_class = "result-card is-depressed" if is_depressed else "result-card"
            badge_text = "STATUS HASIL SKRINING RISIKO TINGGI" if is_depressed else "STATUS HASIL SKRINING RISIKO RENDAH"
            display_title = DISPLAY.get(prediction, prediction)

            st.markdown(f"""
                <div class="{res_card_class}">
                    <div class="result-label">{badge_text}</div>
                    <h2>{display_title}</h2>
                    <p>Hasil prediksi dihitung menggunakan model <strong>{selected_model_name}</strong> berdasarkan data survei klinis CDC NHANES.</p>
                </div>
            """, unsafe_allow_html=True)

            col_res1, col_res2 = st.columns(2)
            with col_res1:
                prob_not = prob_dict.get("Not Depressed", 0.0)
                st.markdown(f"""
                    <div class="probability-card {'is-selected' if not is_depressed else ''}">
                        <div class="probability-name">Peluang Tidak Terindikasi Depresi Mayor</div>
                        <div class="probability-value">{prob_not * 100:.1f}%</div>
                        <div class="probability-track">
                            <div class="probability-fill" style="width: {prob_not * 100}%;"></div>
                        </div>
                    </div>
                """, unsafe_allow_html=True)

            with col_res2:
                prob_dep = prob_dict.get("Depressed", 0.0)
                st.markdown(f"""
                    <div class="probability-card {'is-selected' if is_depressed else ''}">
                        <div class="probability-name">Peluang Berisiko Depresi (PHQ-9 ≥ 10)</div>
                        <div class="probability-value">{prob_dep * 100:.1f}%</div>
                        <div class="probability-track">
                            <div class="probability-fill alert" style="width: {prob_dep * 100}%;"></div>
                        </div>
                    </div>
                """, unsafe_allow_html=True)

            # Clinical interpretation
            st.markdown("### 📋 Interpretasi dan Rekomendasi Klinis")
            if is_depressed:
                st.warning("""
                    **Perhatian:** Responden memiliki profil klinis yang berkorelasi tinggi dengan indikasi depresi mayor (skor kuesioner PHQ-9 ≥ 10).
                    - Faktor pemicu yang sering teridentifikasi meliputi: keluhan gangguan tidur kronis (*trouble sleeping*), ketidakmampuan beraktivitas kerja (*cant work*), gangguan daya ingat/konsentrasi (*memory problems*), serta tingkat waktu sedentari yang tinggi.
                    - **Rekomendasi:** Disarankan untuk berkonsultasi secara tatap muka dengan psikolog klinis, psikiater, atau fasilitas pelayanan kesehatan terdekat untuk evaluasi komprehensif.
                """)
            else:
                st.success("""
                    **Kondisi Relatif Baik:** Responden saat ini memiliki profil dengan risiko depresi mayor yang rendah berdasarkan data skrining kesehatan.
                    - Pertahankan kualitas tidur yang cukup (7–9 jam/hari), aktivitas fisik sedang hingga berat secara rutin, serta manajemen stres yang baik.
                    - Tetap perhatikan kesehatan mental dan jangan ragu mencari dukungan bila mengalami perubahan suasana hati berkepanjangan.
                """)

        except Exception as err:
            st.error(f"Terjadi kesalahan validasi input: {err}")


# ==============================================================================
# 2. HALAMAN: PREDIKSI BATCH (CSV)
# ==============================================================================
elif menu == "📂 Prediksi Batch (CSV)":
    st.markdown("""
        <div class="hero">
            <div class="eyebrow">PREDIKSI MASSAL</div>
            <h1>Prediksi Batch dengan Unggah Berkas CSV</h1>
            <p>Unggah kumpulan data pasien atau responden sekaligus untuk melakukan inferensi otomatis menggunakan model machine learning terpilih.</p>
        </div>
    """, unsafe_allow_html=True)

    c_dl1, c_dl2, _ = st.columns([1.5, 1.5, 3])
    template_path = ROOT_DIR / "Dataset/template_input.csv"
    sample_path = ROOT_DIR / "Dataset/contoh_prediksi.csv"

    if template_path.exists():
        with c_dl1:
            st.download_button(
                "📄 Unduh Format Template CSV",
                data=template_path.read_bytes(),
                file_name="template_input_depresi.csv",
                mime="text/csv",
                use_container_width=True
            )
    if sample_path.exists():
        with c_dl2:
            st.download_button(
                "📑 Unduh Contoh Data Uji (10 Baris)",
                data=sample_path.read_bytes(),
                file_name="contoh_prediksi_depresi.csv",
                mime="text/csv",
                use_container_width=True
            )

    st.markdown("---")
    uploaded_file = st.file_uploader("Unggah Berkas CSV Data Responden", type=["csv"])

    if uploaded_file is not None:
        try:
            df_batch = pd.read_csv(uploaded_file)
            st.markdown(f"**Data Berhasil Dimuat:** {df_batch.shape[0]} baris × {df_batch.shape[1]} kolom")
            st.dataframe(df_batch.head(10), use_container_width=True)

            if st.button("🚀 Mulai Prediksi Batch", type="primary", use_container_width=True):
                with st.spinner("Memvalidasi dan memproses inferensi..."):
                    valid_batch = validate_input(df_batch, SCHEMA)
                    preds = current_model.predict(valid_batch)
                    probs = current_model.predict_proba(valid_batch)

                    results_df = df_batch.copy()
                    results_df["Prediksi_Status"] = preds
                    results_df["Deskripsi_Klinis"] = [DISPLAY.get(p, p) for p in preds]

                    for idx, cls in enumerate(current_model.classes_):
                        results_df[f"Peluang_{cls}"] = np.round(probs[:, idx], 4)

                    dep_count = int((preds == "Depressed").sum())
                    not_dep_count = int((preds == "Not Depressed").sum())
                    total = len(preds)

                    st.success("Inferensi Batch Selesai!")

                    # Ringkasan Metrik
                    m1, m2, m3, m4 = st.columns(4)
                    m1.metric("Total Responden", f"{total:,}")
                    m2.metric("Berisiko Depresi", f"{dep_count:,}", f"{dep_count/total*100:.1f}%")
                    m3.metric("Tidak Terindikasi", f"{not_dep_count:,}", f"{not_dep_count/total*100:.1f}%")
                    m4.metric("Model Digunakan", selected_model_name.split()[0])

                    st.markdown("### Hasil Prediksi Lengkap")
                    st.dataframe(results_df, use_container_width=True)

                    csv_result = results_df.to_csv(index=False).encode("utf-8")
                    st.download_button(
                        "📥 Unduh Hasil Prediksi CSV",
                        data=csv_result,
                        file_name="hasil_skrining_depresi_batch.csv",
                        mime="text/csv",
                        use_container_width=True
                    )

        except Exception as e:
            st.error(f"Gagal memproses berkas CSV: {e}")


# ==============================================================================
# 3. HALAMAN: EKSPLORASI DATA (EDA)
# ==============================================================================
elif menu == "📊 Eksplorasi Data (EDA)":
    st.markdown("""
        <div class="hero">
            <div class="eyebrow">EXPLORATORY DATA ANALYSIS</div>
            <h1>Analisis & Eksplorasi Data Klinis NHANES</h1>
            <p>Eksplorasi karakteristik data kesehatan CDC NHANES (2005–2018) yang terdiri dari 36.259 responden dan 18 fitur klinis relevan.</p>
        </div>
    """, unsafe_allow_html=True)

    summary_file = ROOT_DIR / "Source_Code/reports/eda/summary.json"
    if summary_file.exists():
        s_data = json.loads(summary_file.read_text(encoding="utf-8"))
        e1, e2, e3, e4 = st.columns(4)
        e1.metric("Total Responden", f"{s_data['clean_rows']:,}")
        e2.metric("Fitur Klinis", s_data["model_features"])
        e3.metric("Rasio Berisiko Depresi", f"{s_data['class_counts_raw'].get('Depressed', 3168) / s_data['clean_rows'] * 100:.1f}%")
        e4.metric("Partisi Train : Test", s_data["split_ratio"].split()[0] + " : " + s_data["split_ratio"].split()[3])

    eda_dir = ROOT_DIR / "Source_Code/reports/eda"

    tab1, tab2, tab3, tab4, tab5 = st.tabs([
        "🏷️ Distribusi Target",
        "📈 Sebaran Numerik",
        "📦 Outlier & Boxplot",
        "🔥 Matriks Korelasi",
        "🧩 Fitur Kunci & Gaya Hidup"
    ])

    with tab1:
        st.markdown("### Sebaran Kelas Target: Depresi vs Tidak Depresi")
        st.markdown("""
            Label depresi diturunkan dari ambang batas kuesioner baku **PHQ-9 (Patient Health Questionnaire-9)** dengan batas skor ≥ 10.
            Dari 36.259 responden, 3.168 responden (8,7%) terindikasi depresi dan 33.091 responden (91,3%) tidak terindikasi depresi.
            Ketidakseimbangan kelas (*class imbalance*) ini menjadi alasan pemilihan metrik **Macro-F1** sebagai acuan utama seleksi model.
        """)
        img_class = eda_dir / "01_distribusi_kelas.png"
        if img_class.exists():
            st.image(str(img_class), caption="Grafik 1: Distribusi Label Depresi pada Data Latih dan Uji", use_container_width=True)

    with tab2:
        st.markdown("### Distribusi Fitur Numerik (Data Latih)")
        st.markdown("""
            Fitur numerik mencakup parameter fisiologis (Usia, Durasi Tidur, Waktu Sedentari, BMI, Tekanan Darah Sistolik/Diastolik, dan Denyut Nadi).
            Proses pemodelan menggunakan *StandardScaler* yang di-fit murni pada data latih untuk menghindari kebocoran data (*data leakage*).
        """)
        img_hist = eda_dir / "02_histogram_train.png"
        if img_hist.exists():
            st.image(str(img_hist), caption="Grafik 2: Histogram Fitur Numerik Data Latih", use_container_width=True)

    with tab3:
        st.markdown("### Deteksi Outlier (Metode Interquartile Range / IQR)")
        st.markdown("""
            Outlier dideteksi menggunakan batas $Q1 - 1.5 \\times IQR$ dan $Q3 + 1.5 \\times IQR$.
            Nilai ekstrem pada parameter seperti waktu sedentari atau BMI mencerminkan variasi kondisi kesehatan riil masyarakat dan dipertahankan agar model tahan terhadap variasi klinis lapangan.
        """)
        img_box = eda_dir / "03_boxplot_train.png"
        if img_box.exists():
            st.image(str(img_box), caption="Grafik 3: Boxplot Fitur Numerik Data Latih", use_container_width=True)

        outlier_file = eda_dir / "outliers_train.csv"
        if outlier_file.exists():
            st.dataframe(pd.read_csv(outlier_file), use_container_width=True)

    with tab4:
        st.markdown("### Matriks Korelasi Pearson Antarfitur Numerik")
        st.markdown("""
            Korelasi paling tinggi teramati secara wajar antara Tekanan Darah Sistolik dan Tekanan Darah Diastolik ($r \\approx 0.58$), serta Usia dengan Tekanan Darah Sistolik ($r \\approx 0.45$).
            Tidak terdapat multikolinearitas ekstrem ($r > 0.85$) yang mengganggu kestabilan estimasi model.
        """)
        img_corr = eda_dir / "04_korelasi_train.png"
        if img_corr.exists():
            st.image(str(img_corr), caption="Grafik 4: Matriks Korelasi Antarfitur Numerik", use_container_width=True)

    with tab5:
        st.markdown("### Proporsi Depresi Berdasarkan Fitur Kunci")
        st.markdown("""
            Proporsi responden yang mengalami depresi melonjak signifikan pada individu dengan riwayat kesulitan tidur (*trouble sleeping*), ketidakmampuan bekerja karena kesehatan (*cant work*), serta gangguan daya ingat/konsentrasi (*memory problems*).
        """)
        img_cat = eda_dir / "05_kategorikal_train.png"
        if img_cat.exists():
            st.image(str(img_cat), caption="Grafik 5: Proporsi Depresi Berdasarkan Kategori Kunci", use_container_width=True)

        img_scatter = eda_dir / "06_scatter_train.png"
        if img_scatter.exists():
            st.image(str(img_scatter), caption="Grafik 6: Hubungan Usia vs Jam Tidur", use_container_width=True)


